# En-têtes de Cloudflare Pages. Si un script en ligne change dans une page,
# recalculer son empreinte dans script-src (voir website/README.md).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-V5qJba2Pfl34pHXr5tflSMB61vARUx4poZzLZG+ElkI=' 'sha256-icxNqJihueFkGs4aGvoVPjmigm5HgtVOWZTvhjh62lE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800
